# Server Configuration
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration
# Local Development: mongodb://localhost:27017/dealership_dev
# Production / Staging: mongodb+srv://<user>:<password>@cluster.mongodb.net/dealership
MONGODB_URI=mongodb://localhost:27017/dealership_dev

# Isolated Test Database URI (Must point to an authentic MongoDB instance)
MONGODB_TEST_URI=mongodb://localhost:27017/dealership_test

# JWT Authentication Secret (Placeholder — Replace with cryptographically random key)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Initial Admin Bootstrap Credentials (Used by `npm run seed:admin` or server auto-provisioning)
ADMIN_INITIAL_NAME=System Administrator
ADMIN_INITIAL_EMAIL=admin@incubyte-dealership.com
ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_admin_password
# Set to 'true' if resetting password for an existing administrator account
ADMIN_RESET_PASSWORD=false
